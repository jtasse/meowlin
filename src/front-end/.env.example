NEXT_PUBLIC_API_BASE_URL=https://your-api.execute-api.us-east-1.amazonaws.com/prod
NEXT_PUBLIC_APP_ENV=dev

# Leave empty for local dev (http://localhost:3000). GitHub Actions sets /{repo-name} for Pages.
# NEXT_PUBLIC_BASE_PATH=/meowlin

# Full site URL for Open Graph (optional locally). CI sets https://{owner}.github.io/{repo}.
# NEXT_PUBLIC_PAGES_URL=https://your-user.github.io/meowlin

# CORS is configured on the API/S3 stack (CorsAllowedOrigins in template.yaml), not here.
# Add your GitHub Pages origin when you deploy, e.g. https://your-user.github.io/meowlin